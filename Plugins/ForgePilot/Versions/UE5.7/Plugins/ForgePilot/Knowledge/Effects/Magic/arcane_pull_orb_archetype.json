{
  "archetype_name": "arcane_pull_orb",
  "scope": "V2 sidecar workflow for arcane pull orb reads.",
  "resolved_effect_type": "Magic",
  "required_layers": [
    {
      "id": "A",
      "name": "HeroArcaneSweep",
      "responsibility": "Dominant arcane sweep that gathers or bends magical energy into the orb.",
      "semantic_op_family": "hero_arcane_sweep_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "forbidden_renderer_family": "electrical_zigzag_ribbon",
      "default_material_family": "arcane_hero_streak_material"
    },
    {
      "id": "B",
      "name": "SecondaryArcaneFilaments",
      "responsibility": "Thin supportive arcane filaments that reinforce the pull without closing the silhouette.",
      "semantic_op_family": "secondary_arcane_filament_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "default_material_family": "arcane_hero_streak_material"
    },
    {
      "id": "C",
      "name": "CoreArcaneMass",
      "responsibility": "Dense magical core mass with readable internal activity.",
      "semantic_op_family": "core_arcane_mass_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "arcane_core_mass_material"
    },
    {
      "id": "D",
      "name": "SparkMotes",
      "responsibility": "Small magical motes that add support sparkle and motion detail.",
      "semantic_op_family": "spark_motes_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "arcane_hero_streak_material"
    },
    {
      "id": "E",
      "name": "BindGlow",
      "responsibility": "A soft magical bind glow that ties the core and sweep into one orb read.",
      "semantic_op_family": "bind_glow_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "arcane_core_mass_material"
    }
  ],
  "forbidden_grammar": [
    "flamethrower_fire_plume_read",
    "electrical_zigzag_dominance",
    "closed_ring_orb",
    "over_bloomed_glyph_haze"
  ],
  "default_motion_rules": [
    "Hero layer should read as an arcane pull or sweep, not as a fire jet.",
    "Support filaments stay thin and magical without becoming a closed ring shell.",
    "Core should retain detail under glow."
  ],
  "default_layer_hierarchy": [
    "HeroArcaneSweep",
    "SecondaryArcaneFilaments",
    "CoreArcaneMass",
    "SparkMotes",
    "BindGlow"
  ],
  "default_semantic_ops_plan": [
    "build_hero_streak_material",
    "build_core_merge_glow_material",
    "build_main_attraction_layer",
    "build_secondary_filament_layer",
    "build_core_turbulence_layer",
    "build_sparks_layer",
    "build_shock_glow_layer",
    "review_effect_failure_taxonomy_v2"
  ],
  "visual_contract": {
