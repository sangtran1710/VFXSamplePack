{
  "_description": "Complete recipe for explosion effects in Niagara. Covers small (grenade), medium (vehicle), and large (cinematic) variants.",

  "base_architecture": {
    "system_name_convention": "NS_Explosion_{Variant}",
    "emitter_layers": [
      {
        "name": "Flash",
        "purpose": "Instant bright flash at explosion center — sells the initial energy",
        "priority": "required",
        "renderer": "sprite",
        "material_type": "M_ExplosionFlash (Additive, unlit, radial gradient)",
        "spawn": "burst: 1 particle",
        "particle_lifetime": "0.04-0.08s",
        "initial_size": "200-500 cm (large relative to explosion)",
        "size_over_life": "rapid expand 1→3x in 0.03s",
        "color": "white-yellow, emissive 50-200",
        "opacity_over_life": "1→0 instant fade",
        "sort_order": 10,
        "notes": "This is what the eye registers first. Must be BRIGHT and FAST."
      },
      {
        "name": "Fireball",
        "purpose": "Main expanding fireball body",
        "priority": "required",
        "renderer": "sprite",
        "material_type": "M_Fireball (SubUV flipbook, additive or translucent)",
        "spawn": "burst: 8-20 particles",
        "particle_lifetime": "0.3-0.8s",
        "initial_size": "50-150 cm",
        "size_over_life": "rapid expand 3-5x in first 30%, then slow",
        "velocity": "radial outward 300-800 cm/s + upward bias 20%",
        "color_over_life": "white-yellow (0%) → orange (20%) → dark red (60%) → black transparent (100%)",
        "opacity_over_life": "1.0 (0%) → 0.8 (30%) → 0 (100%)",
        "rotation": "random initial, slow spin",
        "sort_order": 5,
        "notes": "Multiple overlapping sprites create volume. Randomize size ±30%."
      },
      {
        "name": "Smoke_Hot",
        "purpose": "Dark smoke mixed with fireball, transitions from hot to cool",
        "priority": "required",
        "renderer": "sprite",
        "material_type": "M_Smoke_Lit (Translucent, lit, SubUV)",
        "spawn": "burst: 10-25 particles, staggered over 0.1-0.3s",
        "particle_lifetime": "2.0-5.0s",
        "initial_size": "80-200 cm",
        "size_over_life": "grow 2-4x",
        "velocity": "radial outward 100-300 cm/s + strong upward 150-400 cm/s",
        "color_over_life": "dark brown-orange (0%) → dark gray (30%) → lighter gray (100%)",
        "opacity_over_life": "0.4 (0%) → 0.3 (50%) → 0 (100%)",
        "drag": "0.3-0.5 (slows down quickly, then drifts)",
        "sort_order": 2,
        "notes": "This is what lingers. Add curl noise force for organic billowing."
      },
      {
        "name": "Shockwave",
        "purpose": "Fast expanding ring/sphere distortion",
        "priority": "recommended",
        "renderer": "sprite (single, camera-facing) or mesh (ring)",
        "material_type": "M_Shockwave (Refraction + slight emissive edge, Translucent)",
        "spawn": "burst: 1 particle",
        "particle_lifetime": "0.15-0.3s",
        "initial_size": "10 cm",
        "size_over_life": "rapid expand to 500-2000 cm",
        "opacity_over_life": "0.5→0 fast fade",
        "sort_order": 8,
        "notes": "Thin ring mesh with refraction material. Extremely fast expansion."
      },
      {
        "name": "Debris",
        "purpose": "Physical chunks flying outward",
        "priority": "recommended",
        "renderer": "mesh (small rock/metal chunks) or sprite",
        "material_type": "opaque debris material or sprite sheet of chunks",
        "spawn": "burst: 15-40 particles",
        "particle_lifetime": "0.5-2.0s",
        "initial_size": "3-20 cm (random range for variety)",
        "velocity": "radial outward 500-1500 cm/s + upward 200-500 cm/s",
        "gravity": "full gravity (-980 cm/s²)",
        "rotation": "fast random tumble 180-720 deg/s",
        "drag": "0.05-0.15 (minimal, ballistic trajectory)",
        "sort_order": 6,
        "notes": "Must have gravity. Random size variety essential. Add collision with ground if possible."
      },
      {
        "name": "Sparks",
        "purpose": "Bright hot particles streaking outward",
        "priority": "recommended",
        "renderer": "sprite (stretched billboard) or ribbon",
        "material_type": "M_Spark (Additive, simple bright dot)",
        "spawn": "burst: 20-60 particles",
        "particle_lifetime": "0.2-0.6s",
        "initial_size": "2-6 cm",
        "velocity": "radial outward 800-2000 cm/s",
        "gravity": "-980 cm/s² (arcing trajectories)",
        "color": "bright orange-yellow, emissive 10-30",
        "opacity_over_life": "1→0 linear",
        "alignment": "velocity-aligned (stretched in direction of travel)",
        "sort_order": 7,
        "notes": "Stretch factor 2-5x based on velocity. Creates streaks."
      },
      {
        "name": "Dust_Ring",
        "purpose": "Ground-level dust ring expanding outward",
        "priority": "optional (adds grounding)",
        "renderer": "sprite",
        "material_type": "M_Dust (Translucent, unlit or lit, soft)",
        "spawn": "burst: 8-15 particles in ring shape",
        "particle_lifetime": "1.5-4.0s",
        "initial_size": "50-100 cm",
        "size_over_life": "grow 2-3x",
        "velocity": "radial outward along ground plane 200-500 cm/s",
        "color": "brown-tan, matches ground",
        "opacity_over_life": "0.2 (0%) → 0.1 (50%) → 0 (100%)",
        "sort_order": 0,
        "notes": "Keep Y/Z velocity near 0 (horizontal only). Spawn at ground level."
      },
      {
        "name": "Ground_Scorch",
        "purpose": "Burn mark / scorch decal on ground",
        "priority": "optional",
        "renderer": "sprite (ground-oriented) or decal",
        "material_type": "M_ScorchMark (dark, translucent, blends with ground)",
        "spawn": "1 particle, long lifetime",
        "particle_lifetime": "5.0-15.0s (lingers then fades)",
        "initial_size": "150-400 cm",
        "opacity_over_life": "fade in 0.1s, hold, slow fade over 5-10s",
        "sort_order": -1,
        "notes": "Orient flat on ground. Adds permanence to the explosion."
      }
    ]
  },

  "variants": {
    "grenade": {
      "description": "Small contained explosion",
      "scale_factor": 0.4,
      "modifications": {
        "fireball_count": "5-8",
        "debris_count": "10-20",
        "smoke_duration": "shorter (1.5-3s)",
        "skip_layers": ["Ground_Scorch"]
      }
    },
    "vehicle_explosion": {
      "description": "Car/truck explosion with sustained fire",
      "scale_factor": 1.0,
      "modifications": {
        "add_layers": ["Sustained_Fire (continuous fire emitter post-explosion, 3-8s)"],
        "debris": "larger chunks, more variety in size",
        "secondary_explosions": "1-3 smaller bursts at 0.3-1.0s delay"
      }
    },
    "cinematic_large": {
      "description": "Large dramatic explosion for cutscenes",
      "scale_factor": 3.0,
      "modifications": {
        "fireball_count": "25-40",
        "smoke_duration": "5-10s, massive billowing",
        "add_layers": ["Camera_Shake_Emitter", "Light_Flash (point light, 0.1s)"],
        "time_scale": "can slow down for dramatic effect"
      }
    },
    "magical_explosion": {
      "description": "Non-physical, energy-based explosion",
      "modifications": {
        "skip_layers": ["Debris", "Dust_Ring", "Ground_Scorch"],
        "color_override": "use magic color palettes",
        "add_layers": ["Energy_Wisps (particles orbiting then dissipating)", "Rune_Ring (decal ring on ground)"],
        "fireball_material": "replace with energy burst texture"
      }
    }
  },

  "sequencing": {
    "frame_0": "Flash + Shockwave + Fireball burst + Sparks burst + Debris burst",
    "frame_2_5": "Dust ring starts expanding",
    "frame_5_10": "Smoke begins billowing upward, fireball fading",
    "frame_10_30": "Smoke dominates, debris landing, sparks dying",
    "frame_30_plus": "Only smoke and scorch mark remain",
    "note": "At 60fps. Key principle: everything starts together but ENDS at different times."
  },

  "niagara_modules_needed": [
    "Initialize Particle",
    "Spawn Burst Instantaneous",
    "Shape Location (sphere for radial burst)",
    "Add Velocity (radial + upward bias)",
    "Gravity Force (for debris and sparks only)",
    "Drag (per emitter, varies)",
    "Curl Noise Force (smoke only)",
    "Scale Sprite Size (size over life curve)",
    "Color (color over life curve)",
    "Sub UVAnimation (fireball, smoke flipbooks)",
    "Sprite Rotation Rate",
    "Solve Forces and Velocity",
    "Kill Particles When Lifetime Has Elapsed",
    "Sprite Facing Mode (velocity-aligned for sparks)"
  ]
}
