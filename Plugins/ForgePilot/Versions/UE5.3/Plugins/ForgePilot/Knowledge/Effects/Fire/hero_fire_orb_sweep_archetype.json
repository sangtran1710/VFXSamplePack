  "stop_conditions": {
    "required_absent_failures": [
      "hero_sweep_missing",
      "thin_wireframe_ribbons",
      "smoke_plume_silhouette",
      "flat_halo_shell"
    ],
    "max_scalar_only_repairs_before_rebuild": 1,
    "rebuild_layer_a_after_consecutive_motion_failures": 2
  },
  "repair_policy": {
    "hard_rebuild_gate": {
      "layer_a_failure_labels": [
        "hero_sweep_missing",
        "no_outside_to_core_read",
        "thin_wireframe_ribbons",
        "smoke_plume_silhouette"
      ],
      "consecutive_iterations_before_rebuild": 2,
      "block_scalar_only_layer_a_polish": true,
      "scheduled_op": "rebuild_hero_fire_sweep_layer",
      "preserve_layers": [
        "CoreFlameMass",
        "Embers",
        "BindGlow"
      ]
    },
    "soft_repair_mappings": {
      "linework_not_flame_body": [
        "simplify_hero_ribbon_material",
        "retune_longitudinal_flow"
      ],
      "orbit_ring_shell": [
        "build_secondary_filament_layer"
      ],
      "secondary_overwhelms_hero": [
