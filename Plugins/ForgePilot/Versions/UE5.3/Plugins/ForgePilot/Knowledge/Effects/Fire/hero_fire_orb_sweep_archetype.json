{
  "archetype_name": "hero_fire_orb_sweep",
  "scope": "V2 sidecar workflow for hero fire orb sweep reads.",
  "resolved_effect_type": "Fire",
  "required_layers": [
    {
      "id": "A",
      "name": "HeroFireSweep",
      "responsibility": "Dominant sweeping flame stroke that reads as the primary hero body around or into the orb.",
      "semantic_op_family": "hero_fire_sweep_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "forbidden_renderer_family": "thin_wireframe_ribbon",
      "default_material_family": "fire_hero_streak_material"
    },
    {
      "id": "B",
      "name": "SecondaryFireFilaments",
      "responsibility": "Smaller support filaments that reinforce flow without forming a ring shell.",
      "semantic_op_family": "secondary_fire_filament_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "default_material_family": "fire_hero_streak_material"
    },
    {
      "id": "C",
      "name": "CoreFlameMass",
      "responsibility": "Dense burning flame mass in the orb center with readable heat detail.",
      "semantic_op_family": "core_flame_mass_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "fire_core_mass_material"
    },
    {
      "id": "D",
      "name": "Embers",
      "responsibility": "Small ember particles that add heat and motion noise.",
      "semantic_op_family": "embers_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "fire_hero_streak_material"
    },
    {
      "id": "E",
      "name": "BindGlow",
      "responsibility": "A compact glow that binds the core and sweep layers together without turning into a flat halo.",
      "semantic_op_family": "bind_glow_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "fire_core_mass_material"
    }
  ],
  "forbidden_grammar": [
    "smoke_plume_silhouette",
    "orbit_ring_shell",
    "thin_wireframe_ribbons",
    "flat_halo_shell"
  ],
  "default_motion_rules": [
    "Hero layer should read as one dominant flame sweep with 1 to 2 support filaments.",
    "Motion should preserve arc and flame flow, not devolve into a smoke plume or ribbon cage.",
    "Core should feel burning and dense rather than hollow."
  ],
  "default_layer_hierarchy": [
    "HeroFireSweep",
    "SecondaryFireFilaments",
    "CoreFlameMass",
    "Embers",
    "BindGlow"
  ],
  "default_semantic_ops_plan": [
