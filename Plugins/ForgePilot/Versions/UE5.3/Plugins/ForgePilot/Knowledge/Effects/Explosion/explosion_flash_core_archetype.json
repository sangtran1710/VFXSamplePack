{
  "archetype_name": "explosion_flash_core",
  "scope": "V2 sidecar workflow for orb-centric explosion flash core reads.",
  "resolved_effect_type": "Explosion",
  "required_layers": [
    {
      "id": "A",
      "name": "HeroExplosionBurst",
      "responsibility": "Dominant outward explosion burst that sells the primary blast around the flash core.",
      "semantic_op_family": "hero_explosion_burst_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "forbidden_renderer_family": "thin_wireframe_ribbon",
      "default_material_family": "explosion_hero_streak_material"
    },
    {
      "id": "B",
      "name": "SecondaryBlastStreaks",
      "responsibility": "Smaller outward support streaks that reinforce the blast without turning into a ring shell or smoke plume.",
      "semantic_op_family": "secondary_blast_streak_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "default_material_family": "explosion_hero_streak_material"
    },
    {
      "id": "C",
      "name": "CoreFlashMass",
      "responsibility": "White-hot flash core and dense fireball seed that anchors the explosion center.",
      "semantic_op_family": "core_flash_mass_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "explosion_core_mass_material"
    },
    {
      "id": "D",
      "name": "DebrisSparks",
      "responsibility": "Fast sparks and debris-like punctuation that sell violent outward energy.",
      "semantic_op_family": "debris_sparks_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "explosion_hero_streak_material"
    },
    {
      "id": "E",
      "name": "ShockGlow",
      "responsibility": "Compact shock glow that binds the flash and blast layers without turning into a flat halo.",
      "semantic_op_family": "shock_glow_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "explosion_core_mass_material"
    }
  ],
  "forbidden_grammar": [
    "smoke_plume_silhouette",
    "orbit_ring_shell",
    "thin_wireframe_ribbons",
    "flat_halo_shell"
  ],
  "default_motion_rules": [
    "Hero layer should read as a fast outward blast with a clear bright center, not a pull-to-core pattern.",
    "Support streaks should add outward punctuation and not close into an orb shell.",
    "Core flash should feel white-hot and brief, not soft or ambient."
  ],
  "default_layer_hierarchy": [
    "HeroExplosionBurst",
    "SecondaryBlastStreaks",
    "CoreFlashMass",
    "DebrisSparks",
    "ShockGlow"
  ],
  "default_semantic_ops_plan": [
    "build_hero_streak_material",
    "build_core_merge_glow_material",
    "build_main_attraction_layer",
    "build_secondary_filament_layer",
    "build_core_turbulence_layer",
    "build_sparks_layer",
    "build_shock_glow_layer",
    "review_effect_failure_taxonomy_v2"
  ],
