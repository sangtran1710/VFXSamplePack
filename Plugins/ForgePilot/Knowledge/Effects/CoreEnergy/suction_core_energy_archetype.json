{
  "archetype_name": "suction_core_energy",
  "scope": "V2 sidecar workflow for fire/core suction orb reads only.",
  "resolved_effect_type": "CoreEnergy",
  "required_layers": [
    {
      "id": "A",
      "name": "MainAttractionStreaks",
      "responsibility": "Hero streaks that start in the outer zone and bend inward toward the core with only slight tangent/curl motion.",
      "semantic_op_family": "main_attraction_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "forbidden_renderer_family": "orbit_dominant_ribbon",
      "default_material_family": "hero_streak_material"
    },
    {
      "id": "B",
      "name": "SecondaryFilaments",
      "responsibility": "Thinner secondary filaments that support the main pull without overtaking silhouette dominance.",
      "semantic_op_family": "secondary_filament_layer",
      "required_renderer_family": "ribbon_or_sprite",
      "default_material_family": "hero_streak_material"
    },
    {
      "id": "C",
      "name": "CoreTurbulence",
      "responsibility": "Dense, flickering fire/plasma turbulence at the core with readable inner hot detail.",
      "semantic_op_family": "core_turbulence_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "core_merge_glow_material"
    },
    {
      "id": "D",
      "name": "Sparks",
      "responsibility": "Small high-speed sparks and embers that bind the suction read and add high-frequency motion.",
      "semantic_op_family": "sparks_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "hero_streak_material"
    },
    {
      "id": "E",
      "name": "ShockGlow",
      "responsibility": "A subtle bind layer around the core that glues the inner turbulence and streak convergence together.",
      "semantic_op_family": "shock_glow_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "core_merge_glow_material"
    }
  ],
  "forbidden_grammar": [
    "ring_orbit_silhouette",
    "even_spiral_cage",
    "late_width_swelling",
    "overshoot_through_core"
  ],
  "default_motion_rules": [
    "Layer A starts in an outer zone and is pulled toward the core.",
    "Motion is inward with slight curl or tangent support, not orbit-dominant.",
    "Hero hierarchy is one dominant sweep with one to two smaller secondary reads."
  ],
  "default_layer_hierarchy": [
    "MainAttractionStreaks",
    "SecondaryFilaments",
    "CoreTurbulence",
    "Sparks",
    "ShockGlow"
  ],
  "default_semantic_ops_plan": [
    "build_hero_streak_material",
    "build_core_merge_glow_material",
    "build_main_attraction_layer",
    "build_secondary_filament_layer",
    "build_core_turbulence_layer",
    "build_sparks_layer",
    "build_shock_glow_layer",
    "review_suction_core_failure_taxonomy"
  ],
  "visual_contract": {
    "strategy": "prefer_user_parameter_tweak",
    "allow_legacy_stack_fallback": true,
    "auto_create_missing_parameters": true,
    "op_bindings": {
      "build_main_attraction_layer": {
        "layer": "A",
        "bindings": [
          { "param_name": "User.VFX.HeroSpawnRate", "param_type": "float", "value": 42.0 },
          { "param_name": "User.VFX.HeroLifetimeMin", "param_type": "float", "value": 0.55 },
          { "param_name": "User.VFX.HeroLifetimeMax", "param_type": "float", "value": 0.95 },
          { "param_name": "User.VFX.HeroSphereRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.HeroAttractionRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.HeroDrag", "param_type": "float", "value": 1.35 },
          { "param_name": "User.VFX.HeroCurlNoise", "param_type": "float", "value": 0.22 },
          { "param_name": "User.VFX.HeroMaterial", "param_type": "MaterialInterface", "value": "{{material_path}}", "skip_if_empty": true }
        ]
      },
      "rebuild_main_attraction_layer": {
        "layer": "A",
        "bindings": [
          { "param_name": "User.VFX.HeroSpawnRate", "param_type": "float", "value": 42.0 },
          { "param_name": "User.VFX.HeroLifetimeMin", "param_type": "float", "value": 0.55 },
          { "param_name": "User.VFX.HeroLifetimeMax", "param_type": "float", "value": 0.95 },
          { "param_name": "User.VFX.HeroSphereRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.HeroAttractionRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.HeroDrag", "param_type": "float", "value": 1.35 },
          { "param_name": "User.VFX.HeroCurlNoise", "param_type": "float", "value": 0.22 },
          { "param_name": "User.VFX.HeroMaterial", "param_type": "MaterialInterface", "value": "{{material_path}}", "skip_if_empty": true }
        ]
      },
      "retune_motion_family": {
        "layer": "A",
        "bindings": [
          { "param_name": "User.VFX.HeroSpawnRate", "param_type": "float", "value": 42.0 },
          { "param_name": "User.VFX.HeroDrag", "param_type": "float", "value": 1.35 },
          { "param_name": "User.VFX.HeroCurlNoise", "param_type": "float", "value": 0.22 }
        ]
      },
      "build_secondary_filament_layer": {
        "layer": "B",
        "bindings": [
          { "param_name": "User.VFX.SecondarySpawnRate", "param_type": "float", "value": 16.0 },
          { "param_name": "User.VFX.SecondaryLifetimeMin", "param_type": "float", "value": 0.35 },
          { "param_name": "User.VFX.SecondaryLifetimeMax", "param_type": "float", "value": 0.7 },
          { "param_name": "User.VFX.SecondarySphereRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.SecondaryAttractionRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.SecondaryDrag", "param_type": "float", "value": 1.45 },
          { "param_name": "User.VFX.SecondaryCurlNoise", "param_type": "float", "value": 0.18 },
          { "param_name": "User.VFX.SecondaryMaterial", "param_type": "MaterialInterface", "value": "{{material_path}}", "skip_if_empty": true }
        ]
      },
      "build_core_turbulence_layer": {
        "layer": "C",
        "bindings": [
          { "param_name": "User.VFX.CoreSpawnRate", "param_type": "float", "value": 16.0 },
          { "param_name": "User.VFX.CoreLifetimeMin", "param_type": "float", "value": 0.45 },
          { "param_name": "User.VFX.CoreLifetimeMax", "param_type": "float", "value": 0.9 },
          { "param_name": "User.VFX.CoreDrag", "param_type": "float", "value": 0.9 },
          { "param_name": "User.VFX.CoreCurlNoise", "param_type": "float", "value": 0.4 },
          { "param_name": "User.VFX.CoreMaterial", "param_type": "MaterialInterface", "value": "{{material_path}}", "skip_if_empty": true }
        ]
      },
      "build_sparks_layer": {
        "layer": "D",
        "bindings": [
          { "param_name": "User.VFX.SparksSpawnRate", "param_type": "float", "value": 120.0 },
          { "param_name": "User.VFX.SparksLifetimeMin", "param_type": "float", "value": 0.2 },
          { "param_name": "User.VFX.SparksLifetimeMax", "param_type": "float", "value": 0.5 },
          { "param_name": "User.VFX.SparksSphereRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.SparksAttractionRadius", "param_type": "float", "value": 60.0 },
          { "param_name": "User.VFX.SparksDrag", "param_type": "float", "value": 1.1 },
          { "param_name": "User.VFX.SparksMaterial", "param_type": "MaterialInterface", "value": "{{material_path}}", "skip_if_empty": true }
        ]
      },
      "build_shock_glow_layer": {
        "layer": "E",
        "bindings": [
          { "param_name": "User.VFX.GlowSpawnRate", "param_type": "float", "value": 4.0 },
          { "param_name": "User.VFX.GlowLifetimeMin", "param_type": "float", "value": 0.8 },
          { "param_name": "User.VFX.GlowLifetimeMax", "param_type": "float", "value": 1.4 },
          { "param_name": "User.VFX.GlowMaterial", "param_type": "MaterialInterface", "value": "{{material_path}}", "skip_if_empty": true }
        ]
      }
    }
  },
  "stop_conditions": {
    "required_absent_failures": [
      "orbit_dominant",
      "no_outside_to_core_read",
      "hero_sweep_missing",
      "cage_silhouette_risk"
    ],
    "max_scalar_only_repairs_before_rebuild": 1,
    "rebuild_layer_a_after_consecutive_motion_failures": 2
  },
  "repair_policy": {
    "hard_rebuild_gate": {
      "layer_a_failure_labels": [
        "orbit_dominant",
        "no_outside_to_core_read",
        "hero_sweep_missing",
        "cage_silhouette_risk"
      ],
      "consecutive_iterations_before_rebuild": 2,
      "block_scalar_only_layer_a_polish": true,
      "scheduled_op": "rebuild_main_attraction_layer",
      "preserve_layers": [
        "CoreTurbulence",
        "Sparks",
        "ShockGlow"
      ]
    },
    "soft_repair_mappings": {
      "opacity_noise_dominates": [
        "reduce_opacity_noise_preserve_body"
      ],
      "linework_not_flame_body": [
        "simplify_hero_ribbon_material",
        "retune_longitudinal_flow"
      ],
      "shell_ring_dominant": [
        "build_secondary_filament_layer"
      ],
      "secondary_overwhelms_hero": [
        "build_secondary_filament_layer"
      ],
      "inner_hot_core_missing": [
        "build_core_merge_glow_material",
        "build_core_turbulence_layer"
      ]
    }
  },
  "eval_profile": {
    "suite_name": "suction_core_v2_eval",
    "scoring_axes": [
      "motion_family_match",
      "silhouette_family_match",
      "hero_secondary_hierarchy",
      "material_family_read",
      "gameplay_readability"
    ],
    "passing_threshold": 18
  }
}
