    {
      "id": "A",
      "name": "HeroElectricArc",
      "responsibility": "Dominant electric arc sweep that bends or gathers crackling energy into a hot electric core.",
      "semantic_op_family": "hero_electric_arc_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "forbidden_renderer_family": "wire_arc_cage",
      "default_material_family": "electric_hero_streak_material"
    },
    {
      "id": "B",
      "name": "SecondaryElectricFilaments",
      "responsibility": "Thinner supporting electric filaments that reinforce the arc read without closing the orb silhouette.",
      "semantic_op_family": "secondary_electric_filament_layer",
      "required_renderer_family": "sprite_or_stretched_sprite",
      "default_material_family": "electric_hero_streak_material"
    },
    {
      "id": "C",
      "name": "CoreElectricMass",
      "responsibility": "Dense crackling electric core mass with readable white-blue energy concentration.",
      "semantic_op_family": "core_electric_mass_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "electric_core_mass_material"
    },
    {
      "id": "D",
      "name": "SparkBursts",
      "responsibility": "Small electric spark bursts that add punctuation and charge noise.",
      "semantic_op_family": "spark_bursts_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "electric_hero_streak_material"
    },
    {
      "id": "E",
      "name": "BindGlow",
      "responsibility": "Compact electrical glow that binds the hero arc and electric core without becoming a flat halo.",
      "semantic_op_family": "bind_glow_layer",
      "required_renderer_family": "sprite",
      "default_material_family": "electric_core_mass_material"
    }
  ],
  "forbidden_grammar": [
    "closed_ring_orb",
    "wire_arc_cage",
    "thick_flame_body",
    "soft_smoke_haze"
  ],
  "default_motion_rules": [
    "Hero layer should read as one dominant electric arc with smaller support filaments.",
    "Motion should stay crackling and energetic without closing into a ring shell.",
    "Core should read as a charged electric mass, not a smoky haze or flame blob."
  ],
  "default_layer_hierarchy": [
    "HeroElectricArc",
    "SecondaryElectricFilaments",
    "CoreElectricMass",
    "SparkBursts",
    "BindGlow"
